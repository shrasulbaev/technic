# Your domain pointing at this server (A record). HTTPS is set up automatically.
DOMAIN=technic.example.kg

# Database password (any long random string)
POSTGRES_PASSWORD=change-me-long-random

# Session signing key, at least 32 characters: openssl rand -hex 32
SESSION_SECRET=

# Phones that become admins on sign-in, comma separated
ADMIN_PHONES=+996555000001

# stub until an SMS gateway is connected: the code is shown on screen
SMS_PROVIDER=stub
# 1 = demo accounts and quick sign-in buttons (turn off for real users)
DEMO_MODE=0
SEED_DEMO=0
